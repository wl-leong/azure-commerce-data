{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"ls_azure_sql": {
			"type": "string"
		},
		"ls_onprem_sql": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_sync_inventory_delta')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "copy_inventory_to_staging",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "lkp_new_watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "SqlServerSource",
								"sqlReaderQuery": {
									"value": "SELECT invId, upc, productCategory, productSubCategory, productType, modelno, productShortTitle,\n       grossWeight, packageWidth, packageHeight, packageDepth, cbm, eol, firstReceivedDate,\n       updateDate, isExcluded\nFROM dbo.vw_inventory\nWHERE updateDate >  DATEADD(MINUTE, -10, '@{if(equals(pipeline().parameters.loadType, 'Full'), '1900-01-01 00:00:00.000', formatDateTime(activity('lkp_old_watermark').output.firstRow.watermarkValue, 'yyyy-MM-dd HH:mm:ss.fff'))}')\n  AND updateDate <= '@{formatDateTime(activity('lkp_new_watermark').output.firstRow.watermarkValue, 'yyyy-MM-dd HH:mm:ss.fff')}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "EXEC [staging].[SSP_ClearInventory];",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "invId",
											"type": "Int64",
											"physicalType": "bigint"
										},
										"sink": {
											"name": "invId",
											"type": "Int64",
											"physicalType": "bigint"
										}
									},
									{
										"source": {
											"name": "upc",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "upc",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "modelno",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "modelNo",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "productCategory",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "productCategory",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "productSubCategory",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "productSubCategory",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "productType",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "productType",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "productShortTitle",
											"type": "String",
											"physicalType": "varchar"
										},
										"sink": {
											"name": "productShortTitle",
											"type": "String",
											"physicalType": "varchar"
										}
									},
									{
										"source": {
											"name": "grossWeight",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 4,
											"precision": 18
										},
										"sink": {
											"name": "grossWeight",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 0,
											"precision": 18
										}
									},
									{
										"source": {
											"name": "packageWidth",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 2,
											"precision": 18
										},
										"sink": {
											"name": "packageWidth",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 0,
											"precision": 18
										}
									},
									{
										"source": {
											"name": "packageHeight",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 2,
											"precision": 18
										},
										"sink": {
											"name": "packageHeight",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 0,
											"precision": 18
										}
									},
									{
										"source": {
											"name": "packageDepth",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 2,
											"precision": 18
										},
										"sink": {
											"name": "packageDepth",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 0,
											"precision": 18
										}
									},
									{
										"source": {
											"name": "cbm",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 5,
											"precision": 18
										},
										"sink": {
											"name": "cbm",
											"type": "Decimal",
											"physicalType": "decimal",
											"scale": 0,
											"precision": 18
										}
									},
									{
										"source": {
											"name": "eol",
											"type": "Int32",
											"physicalType": "int"
										},
										"sink": {
											"name": "eol",
											"type": "Boolean",
											"physicalType": "bit"
										}
									},
									{
										"source": {
											"name": "isExcluded",
											"type": "Boolean",
											"physicalType": "bit"
										},
										"sink": {
											"name": "isExcluded",
											"type": "Boolean",
											"physicalType": "bit"
										}
									},
									{
										"source": {
											"name": "firstReceivedDate",
											"type": "DateTime",
											"physicalType": "datetime"
										},
										"sink": {
											"name": "firstReceivedDate",
											"type": "Date",
											"physicalType": "date"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_onprem_inventory",
								"type": "DatasetReference"
							}
						],
						"outputs": [
							{
								"referenceName": "ds_azure_inventory_staging",
								"type": "DatasetReference"
							}
						]
					},
					{
