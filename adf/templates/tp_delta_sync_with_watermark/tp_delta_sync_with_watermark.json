								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[SSP_DataSyncRun_Fail]",
							"storedProcedureParameters": {
								"adfRunId": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "Guid"
								},
								"errorCode": {
									"value": "COMPLETE_LOG_FAILED",
									"type": "String"
								},
								"errorMessage": {
									"value": "Complete Sync Log failed",
									"type": "String"
								},
								"failedStep": {
									"value": "CompleteSyncLog",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('ls_azure_sql')]",
							"type": "LinkedServiceReference"
						}
