								},
								"factoryName": {
									"value": {
										"value": "@pipeline().DataFactory",
										"type": "Expression"
									},
									"type": "String"
								},
								"loadType": {
									"value": "Delta",
									"type": "String"
								},
								"pipelineName": {
									"value": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"type": "String"
								},
								"sourceSystem": {
									"value": "OnPremSQL",
									"type": "String"
								},
								"targetObject": {
									"value": "dbo.inventory",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('ls_azure_sql')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "complete_sync_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "publish_inventory",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[SSP_DataSyncRun_Complete]",
							"storedProcedureParameters": {
								"adfRunId": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "Guid"
								},
								"rowsCopied": {
									"value": {
										"value": "@activity('copy_inventory_to_staging').output.rowsCopied",
										"type": "Expression"
									},
									"type": "Int64"
								},
								"rowsRead": {
									"value": {
										"value": "@activity('copy_inventory_to_staging').output.rowsRead",
										"type": "Expression"
									},
									"type": "Int64"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('ls_azure_sql')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "fail_copy_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "copy_inventory_to_staging",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[SSP_DataSyncRun_Fail]",
							"storedProcedureParameters": {
								"adfRunId": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "Guid"
								},
								"errorCode": {
									"value": "COPY_FAILED",
									"type": "String"
								},
								"errorMessage": {
									"value": "Inventory sync failed during staging copy.",
									"type": "String"
								},
								"failedStep": {
									"value": "Copy to staging failed; inspect ADF diagnostics.",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('ls_azure_sql')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "fail_publish_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "publish_inventory",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[dbo].[SSP_DataSyncRun_Fail]",
							"storedProcedureParameters": {
								"adfRunId": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "Guid"
								},
								"errorCode": {
									"value": "PUBLISH_FAILED",
									"type": "String"
								},
								"errorMessage": {
									"value": "Inventory publish to table failed",
									"type": "String"
								},
								"failedStep": {
									"value": "PublishInventory",
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('ls_azure_sql')]",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "fail_complete_log",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "complete_sync_log",
