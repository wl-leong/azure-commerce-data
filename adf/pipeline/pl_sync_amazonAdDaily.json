{
	"name": "pl_sync_amazonAdDaily",
	"properties": {
		"description": "Amazon Ads daily report CSV (Azure Blob, one file per run) -> tech_mcp staging.amazonAdDaily -> dbo.amazonAdDaily. Insert only: publish replaces rows of the same file (full blob path) and keeps other files. Run by tr_blob_amazonAdDaily, or manually with folderPath '<container>/<folder>' and fileName.",
		"activities": [
			{
				"name": "start_sync_log",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SSP_DataSyncRun_Start]",
					"storedProcedureParameters": {
						"adfRunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "Guid"
						},
						"factoryName": {
							"value": {
								"value": "@pipeline().DataFactory",
								"type": "Expression"
							},
							"type": "String"
						},
						"pipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"environmentName": {
							"value": {
								"value": "@if(endswith(pipeline().DataFactory, '-prod'), 'prod', 'dev')",
								"type": "Expression"
							},
							"type": "String"
						},
						"domain": {
							"value": "Advertising",
							"type": "String"
						},
						"entityName": {
							"value": "amazonAdDaily",
							"type": "String"
						},
						"sourceSystem": {
							"value": "amazonAds",
							"type": "String"
						},
						"targetObject": {
							"value": "dbo.AmazonAdDaily",
							"type": "String"
						},
						"loadType": {
							"value": "Delta",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azure_sql",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "clear_staging",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "start_sync_log",
						"dependencyConditions": [
