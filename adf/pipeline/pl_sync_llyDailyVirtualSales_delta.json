						"sqlReaderQuery": "SELECT CASE WHEN a.w > b.w THEN a.w ELSE b.w END AS watermarkValue\nFROM (SELECT MAX(modifiedon) AS w FROM dbo.so_shpd_created) a\nCROSS JOIN (SELECT MAX(modifiedon) AS w FROM dbo.so_shpd) b",
